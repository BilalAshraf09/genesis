# Optional live AI evaluation (OpenAI Chat Completions).
# Without this key, Genesis uses the built-in mock evaluator.
# Core historical timeline play does not require any API key.
EXPO_PUBLIC_OPENAI_API_KEY=

# --- RevenueCat (Android / iOS store builds) ---
# Public SDK API key from RevenueCat → Project → API keys.
# Missing → MockBilling (sandbox) on all platforms (Expo web / Try Live).
# With this key on Android or iOS: PlayBilling configures Purchases, checks
# entitlement `genesis_pro`, presents Paywalls UI + Customer Center.
# Packages expected on the *current* offering: lifetime · yearly · monthly.
# Set the real key in local `.env` (gitignored) and as an EAS Secret for builds.
# NEVER commit the raw key — placeholder only in this file:
EXPO_PUBLIC_REVENUECAT_KEY=your_revenuecat_public_sdk_key

# Optional: real weekly leaderboard API (JSON { rows: [{ name, score, theater, path }] }).
# Empty → mock global roster + local AsyncStorage PB overwrite.
EXPO_PUBLIC_LEADERBOARD_API_URL=

# Universal-link host stub for https://{host}/invite share lines.
# Play intentFilters also use this host (genesis.app). Verified App Links need
# Digital Asset Links on that domain — custom scheme genesis://invite still works without it.
EXPO_PUBLIC_UNIVERSAL_LINK_HOST=genesis.app

# --- Play Console / store listing (not read by the app binary) ---
# Host your own privacy policy and paste the public HTTPS URL into Play Console
# (App content → Privacy policy) and Data safety. Do not invent a placeholder URL.
# PRIVACY_POLICY_URL=
