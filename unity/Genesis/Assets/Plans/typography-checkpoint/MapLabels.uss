/*
MapLabels.uss — Europe Desk tooltip style (CrisisUI_Reference)
*/

.map-label-root {
    position: absolute;
    width: 100%;
    height: 100%;
    overflow: hidden;
}

.country-label {
    position: absolute;
    font-size: var(--type-map-label);
    color: rgba(169, 179, 196, 0.62);
    letter-spacing: var(--track-meta);
    -unity-font-definition: url("project://database/Assets/UI/Fonts/Inter-SemiBold SDF.asset");
    -unity-text-align: middle-center;
    text-shadow: 1px 1px 0 rgba(11, 18, 32, 0.85);
    white-space: nowrap;
    overflow: visible;
}

.pin-label {
    position: absolute;
    font-size: var(--type-map-label);
    color: #F2EFE6;
    -unity-font-definition: url("project://database/Assets/UI/Fonts/Inter-SemiBold SDF.asset");
    letter-spacing: var(--track-title);
    -unity-text-align: middle-left;
    text-shadow: 0 2px 6px rgba(0, 0, 0, 0.95);
    white-space: nowrap;
    overflow: visible;
}

.pin-label--selected {
    font-size: 20px;
    color: #F5A524;
    text-shadow: 0 0 12px rgba(245, 165, 36, 0.6);
}

.pin-dot {
    position: absolute;
    width: 12px;
    height: 12px;
    border-radius: 6px;
    background-color: #F2EFE6;
    border-width: 2px;
    border-color: #0B1220;
}

.pin-halo {
    position: absolute;
    width: 36px;
    height: 36px;
    border-radius: 18px;
    background-color: rgba(245, 165, 36, 0.28);
    border-width: 0;
}

.pin-dot--selected {
    background-color: #FFFFFF;
    width: 14px;
    height: 14px;
    border-radius: 7px;
    border-color: #F5A524;
    border-width: 4px;
}

/* Selected pin tooltip — width set from C# to the map viewport */
.pin-fact-bubble {
    position: absolute;
    background-color: rgba(11, 18, 32, 0.97);
    border-radius: 10px;
    border-width: 2px;
    border-color: #F5A524;
    padding: 10px 14px 10px 14px;
    min-width: 180px;
    max-width: 92%;
    min-height: 64px;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    transition-duration: 0.15s;
}

.pin-fact-title {
    color: #F5A524;
    font-size: var(--type-callout-title);
    -unity-text-align: middle-left;
    margin-bottom: 3px;
    letter-spacing: var(--track-meta);
    -unity-font-definition: url("project://database/Assets/UI/Fonts/Inter-SemiBold SDF.asset");
}

.pin-fact-body-row {
    flex-direction: row;
    align-items: center;
    width: 100%;
}

.pin-fact-pin {
    font-size: var(--type-body);
    color: #F2EFE6;
    margin-right: 6px;
    flex-shrink: 0;
    margin-top: 0;
}

.pin-fact-body {
    color: #F2EFE6;
    font-size: var(--type-callout-body);
    -unity-text-align: middle-left;
    white-space: normal;
    flex-grow: 1;
    letter-spacing: 0;
    -unity-font-definition: url("project://database/Assets/UI/Fonts/Inter-Regular SDF.asset");
}

@media (max-width: 360px) {
    .pin-fact-bubble {
        width: 220px;
        min-height: 52px;
        padding: 8px 12px;
    }

    .pin-fact-title {
        font-size: 14px;
    }

    .pin-fact-body {
        font-size: 13px;
    }
}

.pin-fact-caret {
    position: absolute;
    bottom: -7px;
    left: 50%;
    width: 12px;
    height: 12px;
    background-color: rgba(11, 18, 32, 0.97);
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-color: #F5A524;
    rotate: 45deg;
    translate: -6px 0;
}
