/*
2026-10-02 AI-Tag
This was created with the help of Assistant, a Unity Artificial Intelligence product.
*/
/*
   Genesis — After Action screen styles
   Only screen-specific rules. Do NOT edit tokens.uss / components.uss.
   Reference resolution: 1080 × 1920.
*/

/* ── Root background ── */
.after-action {
    flex-grow: 1;
    background-color: #0B1220;
    flex-direction: column;
}

.after-action__scroll {
    flex-grow: 1;
}

/* Content stack inside the scroll */
.after-action__stack {
    flex-direction: column;
    padding-left: 24px;
    padding-right: 24px;
    padding-top: 32px;
    padding-bottom: 40px;
}

/* ── Header (theater title + meta) ── */
.after-action__header {
    flex-direction: column;
    margin-bottom: 24px;
}

.after-action__theater-title {
    font-size: 44px;
    color: #F2EFE6;
    -unity-font-definition: url("project://database/Assets/UI/Fonts/Inter-SemiBold SDF.asset");
    -unity-text-align: upper-left;
    white-space: normal;
    flex-shrink: 0;
}

.after-action__theater-meta {
    font-size: 28px;
    color: #6E7A8F;
    margin-top: 4px;
}

/* ── Score ring section (glass card) ── */
.after-action__score-section {
    padding-top: 32px;
    padding-bottom: 32px;
    padding-left: 24px;
    padding-right: 24px;
    margin-bottom: 16px;
    align-items: center;
    flex-direction: column;
}

ScoreRing {
    width: 240px;
    height: 240px;
    flex-shrink: 0;
    flex-direction: column;
    align-items: center;
    justify-content: center;
}

.score-ring__rank {
    font-size: 96px;
    color: #F5A524;
    -unity-font-definition: url("project://database/Assets/UI/Fonts/Inter-SemiBold SDF.asset");
    -unity-text-align: middle-center;
    margin-top: 16px;
}

.score-ring__score {
    font-size: 36px;
    color: #A9B3C4;
    -unity-text-align: middle-center;
    margin-top: 2px;
}

.after-action__rank-title {
    font-size: 36px;
    color: #F5A524;
    -unity-font-definition: url("project://database/Assets/UI/Fonts/Inter-SemiBold SDF.asset");
    -unity-text-align: middle-center;
    margin-top: 8px;
}

.after-action__headline {
    font-size: 30px;
    color: #A9B3C4;
    -unity-text-align: middle-center;
    white-space: normal;
    margin-top: 8px;
}

/* ── Section label (reused across cards) ── */
.after-action__section-label {
    font-size: 28px;
    color: #6E7A8F;
    -unity-font-definition: url("project://database/Assets/UI/Fonts/Inter-SemiBold SDF.asset");
    margin-bottom: 16px;
    flex-shrink: 0;
}

/* ── Pillars card ── */
.after-action__pillars {
    margin-bottom: 16px;
}

.pillar-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 14px;
    flex-shrink: 0;
}

.pillar-name {
    width: 192px;
    font-size: 28px;
    color: #F2EFE6;
    flex-shrink: 0;
}

.pillar-track {
    flex-grow: 1;
    margin-left: 8px;
    margin-right: 12px;
}

.pillar-pct {
    width: 64px;
    font-size: 28px;
    color: #A9B3C4;
    -unity-text-align: middle-right;
    flex-shrink: 0;
}

/* Per-pillar meter fill colours */
.meter__fill--stability    { background-color: #3FB97A; }
.meter__fill--credibility  { background-color: #5AA9E6; }
.meter__fill--civilian     { background-color: #E5534B; }
.meter__fill--escalation   { background-color: #F5A524; }

/* ── Path vs history card ── */
.after-action__path {
    margin-bottom: 16px;
    flex-direction: column;
}

.after-action__closing {
    font-size: 30px;
    color: #F2EFE6;
    white-space: normal;
    margin-bottom: 16px;
}

.after-action__path-chips {
    flex-direction: row;
    flex-wrap: wrap;
}

.after-action__path-chips > .chip {
    margin-right: 8px;
    margin-bottom: 8px;
}

/* ── Decisions card ── */
.after-action__decisions {
    margin-bottom: 16px;
}

.decision-row {
    flex-direction: row;
    align-items: center;
    padding-top: 12px;
    padding-bottom: 12px;
    padding-left: 14px;
    padding-right: 14px;
    margin-bottom: 8px;
    background-color: #111A2B;
    border-radius: 10px;
    border-width: 1px;
    border-color: #FFFFFF14;
    flex-shrink: 0;
}

.decision-phase {
    width: 56px;
    font-size: 26px;
    color: #6E7A8F;
    flex-shrink: 0;
}

.decision-callsign {
    flex-grow: 1;
    font-size: 28px;
    color: #F2EFE6;
    -unity-font-definition: url("project://database/Assets/UI/Fonts/Inter-SemiBold SDF.asset");
    white-space: normal;
}

/* ── Places learned card ── */
.after-action__places {
    margin-bottom: 16px;
}

.after-action__chips-row {
    flex-direction: row;
    flex-wrap: wrap;
}

.chip--new {
    background-color: rgba(245, 165, 36, 0.18);
    border-width: 1px;
    border-color: #F5A524;
    color: #F5A524;
    border-radius: 20px;
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 6px;
    padding-bottom: 6px;
    font-size: 26px;
    -unity-font-definition: url("project://database/Assets/UI/Fonts/Inter-SemiBold SDF.asset");
    margin-right: 8px;
    margin-bottom: 8px;
    align-self: flex-start;
}

.chip--known {
    background-color: #17233A;
    border-width: 1px;
    border-color: #FFFFFF14;
    color: #A9B3C4;
    border-radius: 20px;
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 6px;
    padding-bottom: 6px;
    font-size: 26px;
    margin-right: 8px;
    margin-bottom: 8px;
    align-self: flex-start;
}

/* ── Map thumbnail (glass card, 200px) ── */
.after-action__map-section {
    height: 200px;
    margin-bottom: 16px;
    overflow: hidden;
    justify-content: flex-end;
    align-items: flex-start;
    padding: 0;
    border-radius: 20px;
    border-width: 1px;
    border-color: #FFFFFF14;
}

.after-action__map-thumb {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    -unity-background-scale-mode: scale-and-crop;
}

.after-action__map-label {
    font-size: 26px;
    color: #F2EFE6;
    background-color: #111A2BDB;
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 4px;
    padding-bottom: 4px;
    border-radius: 8px;
    margin-left: 12px;
    margin-bottom: 12px;
}

/* ── Action buttons ── */
.after-action__actions {
    flex-direction: column;
    margin-top: 8px;
}

.after-action__share-btn {
    margin-bottom: 12px;
}

.after-action__action-row {
    flex-direction: row;
    margin-bottom: 12px;
}

.after-action__action-row > .btn {
    flex-grow: 1;
}

.after-action__action-row > .btn--redeploy {
    margin-right: 10px;
}

.after-action__codex-btn {
    border-width: 1px;
    border-color: #D9B45A;
    color: #D9B45A;
}

.after-action__codex-btn > Label {
    color: #D9B45A;
}

.after-action__share-status {
    font-size: 28px;
    color: #3FB97A;
    -unity-text-align: middle-center;
    margin-top: 8px;
    min-height: 36px;
}
