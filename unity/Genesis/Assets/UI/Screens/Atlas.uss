/* ============================================================
   Genesis — Atlas (Theater Select)  (Night Atlas)
   ============================================================ */

/* ── Screen root ─────────────────────────────────────────── */
.atlas-screen {
    flex-grow: 1;
    flex-direction: column;
    background-color: #0B1220;
}

/* ── Header bar ──────────────────────────────────────────── */
.atlas-header {
    flex-direction: row;
    align-items: center;
    background-color: #111A2BDB;
    border-bottom-width: 1px;
    border-color: #FFFFFF14;
    padding-left: 16px;
    padding-right: 24px;
    padding-top: 16px;
    padding-bottom: 16px;
    flex-shrink: 0;
}

.atlas-header__back-btn {
    background-color: rgba(0,0,0,0);
    border-width: 0;
    border-radius: 12px;
    width: 72px;
    height: 72px;
    align-items: center;
    justify-content: center;
    margin-right: 8px;
    transition-duration: 0.12s;
}

.atlas-header__back-btn > Label {
    font-size: 32px;
    color: #F2EFE6;
}

.atlas-header__back-btn:active {
    scale: 0.92 0.92;
    background-color: #FFFFFF14;
}

.atlas-header__title {
    font-size: 40px;
    color: #F2EFE6;
    -unity-font-definition: url("project://database/Assets/UI/Fonts/Inter-SemiBold SDF.asset");
    letter-spacing: 6px;
    flex-grow: 1;
}

/* ── Resume banner ───────────────────────────────────────── */
.atlas-resume-banner {
    background-color: #111A2BDB;
    border-width: 1px;
    border-color: #F5A52440;
    border-radius: 16px;
    margin-left: 16px;
    margin-right: 16px;
    margin-top: 12px;
    padding: 16px;
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
}

.atlas-resume-banner__info {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    flex-direction: column;
    margin-right: 12px;
}

.atlas-resume-banner__title {
    font-size: 30px;
    color: #F2EFE6;
    -unity-font-definition: url("project://database/Assets/UI/Fonts/Inter-SemiBold SDF.asset");
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    min-width: 0;
}

.atlas-resume-banner__meta {
    font-size: 26px;
    color: #A9B3C4;
    margin-top: 4px;
}

.atlas-resume-banner__actions {
    flex-direction: column;
    flex-shrink: 0;
}

.atlas-resume-btn {
    background-color: #F5A524;
    border-width: 0;
    border-radius: 14px;
    min-width: 140px;
    height: 68px;
    align-items: center;
    justify-content: center;
    padding-left: 16px;
    padding-right: 16px;
    margin-bottom: 6px;
    transition-duration: 0.12s;
}

.atlas-resume-btn > Label {
    font-size: 26px;
    color: #1A1206;
    -unity-font-definition: url("project://database/Assets/UI/Fonts/Inter-SemiBold SDF.asset");
}

.atlas-resume-btn:active { scale: 0.97 0.97; }

.atlas-abandon-btn {
    background-color: rgba(0,0,0,0);
    border-width: 1px;
    border-color: #E5534B80;
    border-radius: 14px;
    min-width: 140px;
    height: 52px;
    align-items: center;
    justify-content: center;
    padding-left: 12px;
    padding-right: 12px;
    transition-duration: 0.12s;
}

.atlas-abandon-btn > Label {
    font-size: 24px;
    color: #E5534B;
}

.atlas-abandon-btn:active { scale: 0.97 0.97; }

/* ── Region filter row ────────────────────────────────────── */
.atlas-filter-bar {
    flex-shrink: 0;
    margin-top: 12px;
    padding-left: 16px;
    padding-right: 16px;
}

.atlas-filter-bar > #unity-content-container {
    flex-direction: row;
    padding-top: 4px;
    padding-bottom: 8px;
}

.region-chip {
    background-color: #17233A;
    border-width: 1px;
    border-color: #FFFFFF14;
    border-radius: 40px;
    padding-left: 20px;
    padding-right: 20px;
    padding-top: 10px;
    padding-bottom: 10px;
    margin-right: 8px;
    flex-shrink: 0;
    height: 60px;
    align-items: center;
    justify-content: center;
    transition-duration: 0.12s;
}

.region-chip > Label {
    font-size: 26px;
    color: #A9B3C4;
}

.region-chip--active {
    background-color: #F5A52426;
    border-color: #F5A524;
}

.region-chip--active > Label {
    color: #F5A524;
}

.region-chip:active { scale: 0.95 0.95; }

/* ── Theater list scroll ─────────────────────────────────── */
.atlas-scroll {
    flex-grow: 1;
    padding-left: 16px;
    padding-right: 16px;
    padding-top: 12px;
    padding-bottom: 24px;
}

.atlas-scroll > .unity-scroll-view__vertical-scroller {
    width: 0;
    min-width: 0;
    opacity: 0;
    display: none;
}

.atlas-filter-bar > .unity-scroll-view__horizontal-scroller {
    height: 0;
    min-height: 0;
    opacity: 0;
    display: none;
}

.atlas-scroll > #unity-content-container {
    flex-direction: column;
}

/* ── Theater card ─────────────────────────────────────────── */
.theater-card {
    background-color: #17233A;
    border-width: 1px;
    border-color: #FFFFFF14;
    border-radius: 20px;
    margin-bottom: 12px;
    overflow: hidden;
    flex-direction: column;
    flex-shrink: 0;
    transition-duration: 0.12s;
}

.theater-card:active {
    scale: 0.98 0.98;
    border-color: #F5A52480;
}

.theater-card__thumb {
    width: 100%;
    height: 188px;
    -unity-background-scale-mode: scale-and-crop;
    background-color: #0B1220;
}

.theater-card__body {
    flex-direction: column;
    padding: 16px;
}

.theater-card__year {
    font-size: 24px;
    color: #F5A524;
    margin-bottom: 4px;
}

.theater-card__title {
    font-size: 32px;
    color: #F2EFE6;
    -unity-font-definition: url("project://database/Assets/UI/Fonts/Inter-SemiBold SDF.asset");
    white-space: normal;
    margin-bottom: 6px;
}

.theater-card__premise {
    font-size: 26px;
    color: #A9B3C4;
    white-space: normal;
    margin-bottom: 10px;
}

.theater-card__footer {
    flex-direction: row;
    align-items: center;
}

.theater-card__places {
    font-size: 24px;
    color: #6E7A8F;
    flex-grow: 1;
}

.theater-card__score {
    font-size: 24px;
    color: #F5A524;
}
