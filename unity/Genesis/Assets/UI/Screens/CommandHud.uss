/* CommandHud.uss — Top bar + meter strip for the GenesisPlay command screen.
   Uses tokens + component classes from Genesis.tss (loaded via PanelSettings).
   Do NOT edit tokens.uss or components.uss — new rules only here. */

/* ---- Layout helpers ----------------------------------------- */

.screen-fill {
    flex-grow: 1;
    flex-direction: column;
}

.flex-grow {
    flex-grow: 1;
}

.hidden {
    display: none;
}

.top-container {
    flex-direction: column;
    flex-shrink: 0;
}

/* ---- Top bar ------------------------------------------------- */

.top-bar {
    flex-direction: row;
    align-items: center;
    padding-left: 28px;
    padding-right: 28px;
    padding-top: 18px;
    padding-bottom: 14px;
    min-height: 118px;
    background-color: rgba(11, 18, 32, 0.92);
    border-bottom-width: 0;
    border-radius: 0;
}

.back-btn {
    width: 68px;
    height: 68px;
    border-radius: 20px;
    background-color: rgba(255, 255, 255, 0.06);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.12);
    margin-right: 20px;
    align-items: center;
    justify-content: center;
    padding: 0;
    flex-shrink: 0;
    transition-duration: 0.15s;
}

.back-btn > Label {
    color: var(--color-text-primary);
    font-size: 26px;
    -unity-text-align: middle-center;
    margin-right: 4px;
}

.back-btn:hover {
    background-color: rgba(255, 255, 255, 0.10);
    border-color: rgba(245, 165, 36, 0.35);
}

.back-btn:active {
    background-color: rgba(255, 255, 255, 0.14);
    scale: 0.94 0.94;
}

.top-title-stack {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    flex-direction: column;
    justify-content: center;
}

.ops-tag {
    font-size: 18px;
    color: var(--color-accent);
    letter-spacing: 2px;
    -unity-font-definition: url("project://database/Assets/UI/Fonts/Inter-SemiBold SDF.asset");
    margin-bottom: 2px;
    opacity: 0.9;
}

.top-title {
    flex-grow: 0;
    flex-shrink: 1;
    min-width: 0;
    font-size: 34px;
    color: var(--color-text-primary);
    -unity-font-definition: url("project://database/Assets/UI/Fonts/Inter-SemiBold SDF.asset");
    letter-spacing: 0.5px;
    text-shadow: 0 2px 6px rgba(0, 0, 0, 0.55);
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.top-right-group {
    align-items: flex-end;
    flex-shrink: 0;
    flex-direction: column;
    justify-content: center;
    margin-left: 12px;
}

.phase-pill {
    background-color: rgba(245, 165, 36, 0.12);
    border-width: 1px;
    border-color: rgba(245, 165, 36, 0.35);
    border-radius: 20px;
    padding-left: 14px;
    padding-right: 14px;
    padding-top: 4px;
    padding-bottom: 4px;
    margin-bottom: 8px;
}

.phase-label {
    font-size: 22px;
    color: var(--color-accent);
    -unity-font-definition: url("project://database/Assets/UI/Fonts/Inter-SemiBold SDF.asset");
    letter-spacing: 0.5px;
    margin-bottom: 0;
}

.timer-block {
    flex-direction: column;
    align-items: flex-end;
    min-width: 120px;
}

.timer-label {
    font-size: 28px;
    color: var(--color-text-primary);
    -unity-font-definition: url("project://database/Assets/UI/Fonts/Inter-SemiBold SDF.asset");
    margin-bottom: 6px;
    letter-spacing: 1px;
    transition-property: color;
    transition-duration: 0.25s;
}

.timer-label--warn {
    color: var(--color-accent);
}

.timer-label--urgent {
    color: var(--color-cost);
}

/* ---- Timer bar ---------------------------------------------- */

.timer-bar {
    width: 128px;
    height: 7px;
    background-color: rgba(0, 0, 0, 0.35);
    border-radius: 4px;
    overflow: hidden;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.06);
}

.timer-fill {
    height: 100%;
    background-color: var(--color-accent);
    border-radius: 3px;
    transition-property: background-color, width;
    transition-duration: 0.35s;
}

.timer-fill--warn {
    background-color: var(--color-diplomacy);
}

.timer-fill--urgent {
    background-color: var(--color-cost);
}

/* ---- Accent line under top bar ------------------------------ */

.top-accent-line {
    height: 2px;
    background-color: rgba(245, 165, 36, 0.55);
    flex-shrink: 0;
}

/* ---- Meter strip --------------------------------------------- */

.meter-strip {
    flex-direction: row;
    padding-left: 28px;
    padding-right: 28px;
    padding-top: 14px;
    padding-bottom: 14px;
    background-color: rgba(11, 18, 32, 0.88);
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.06);
    min-height: 76px;
}

.meter-col {
    flex: 1;
    flex-direction: column;
    margin-left: 8px;
    margin-right: 8px;
}

.meter-label-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 8px;
}

.meter-dot {
    width: 8px;
    height: 8px;
    border-radius: 4px;
    margin-right: 8px;
    flex-shrink: 0;
}

.meter-dot--stab { background-color: var(--color-gain); }
.meter-dot--cred { background-color: var(--color-info); }
.meter-dot--toll { background-color: var(--color-cost); }
.meter-dot--esc  { background-color: var(--color-accent); }

.meter-label {
    font-size: 20px;
    color: var(--color-text-muted);
    margin-bottom: 0;
    -unity-font-definition: url("project://database/Assets/UI/Fonts/Inter-SemiBold SDF.asset");
    letter-spacing: 1.5px;
}

.meter {
    height: 9px;
    background-color: rgba(0, 0, 0, 0.35);
    border-radius: 5px;
    overflow: hidden;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.04);
}

.meter__fill {
    height: 100%;
    border-radius: 4px;
    transition-duration: 0.8s;
}

.meter__fill--stab { background-color: var(--color-gain); }
.meter__fill--cred { background-color: var(--color-info); }
.meter__fill--toll { background-color: var(--color-cost); }
.meter__fill--esc  { background-color: var(--color-accent); }

/* Soft blend into map */
.hud-map-fade {
    height: 28px;
    background-color: rgba(11, 18, 32, 0.45);
    flex-shrink: 0;
}

/* ---- Intel chip ---------------------------------------------- */

.intel-chip {
    margin-left: 28px;
    margin-right: 28px;
    margin-top: 10px;
    padding: 0;
    flex-direction: row;
    align-items: stretch;
    background-color: rgba(17, 26, 43, 0.94);
    border-radius: 16px;
    border-width: 1px;
    border-color: rgba(90, 169, 230, 0.28);
    overflow: hidden;
    opacity: 1;
    translate: 0 0;
    transition-property: opacity, translate;
    transition-duration: 0.28s;
}

.intel-chip--enter {
    opacity: 0;
    translate: 0 -12px;
}

.intel-accent {
    width: 5px;
    background-color: var(--color-info);
    flex-shrink: 0;
}

.intel-icon {
    font-size: 28px;
    color: var(--color-info);
    margin-left: 16px;
    margin-right: 12px;
    flex-shrink: 0;
    -unity-text-align: middle-center;
    align-self: center;
}

.intel-body {
    flex-grow: 1;
    font-size: 28px;
    color: var(--color-text-primary);
    white-space: normal;
    padding-top: 16px;
    padding-bottom: 16px;
    padding-right: 18px;
    -unity-text-align: middle-left;
}

/* ---- Field brief card ---------------------------------------- */

.field-brief {
    margin-left: 28px;
    margin-right: 28px;
    margin-top: 10px;
    padding: 22px 26px;
    flex-direction: column;
    background-color: rgba(17, 26, 43, 0.94);
    border-radius: 18px;
    border-width: 1px;
    border-color: rgba(245, 165, 36, 0.32);
    opacity: 1;
    translate: 0 0;
    transition-property: opacity, translate;
    transition-duration: 0.32s;
}

.field-brief--enter {
    opacity: 0;
    translate: 0 -16px;
}

.ui-enter {
    opacity: 0;
    translate: 0 -8px;
    transition-property: opacity, translate;
    transition-duration: 0.28s;
}

.brief-headline {
    font-size: 32px;
    color: var(--color-accent);
    -unity-font-definition: url("project://database/Assets/UI/Fonts/Inter-SemiBold SDF.asset");
    margin-bottom: 6px;
    letter-spacing: 0.5px;
}

.brief-fact {
    font-size: 28px;
    color: var(--color-text-secondary);
    white-space: normal;
}

/* ---- Commit toast -------------------------------------------- */

.commit-toast {
    align-self: center;
    margin-top: 14px;
    font-size: 30px;
    color: var(--color-accent);
    -unity-font-definition: url("project://database/Assets/UI/Fonts/Inter-SemiBold SDF.asset");
    -unity-text-align: middle-center;
    padding: 14px 36px;
    background-color: rgba(245, 165, 36, 0.16);
    border-radius: 40px;
    border-width: 1px;
    border-color: rgba(245, 165, 36, 0.4);
    opacity: 1;
    scale: 1 1;
    transition-property: opacity, scale;
    transition-duration: 0.22s;
}

.commit-toast--enter {
    opacity: 0;
    scale: 0.94 0.94;
}

/* ---- Mission toast (absolute, centered) ---------------------- */

.mission-toast {
    position: absolute;
    left: 40px;
    right: 40px;
    top: 38%;
    font-size: 42px;
    color: var(--color-text-primary);
    -unity-text-align: middle-center;
    -unity-font-definition: url("project://database/Assets/UI/Fonts/Inter-SemiBold SDF.asset");
    background-color: rgba(11, 18, 32, 0.96);
    padding: 40px;
    border-radius: 20px;
    align-self: center;
    border-width: 2px;
    border-color: var(--color-accent);
    text-shadow: 0 4px 8px rgba(0, 0, 0, 0.8);
}
