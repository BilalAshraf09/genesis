/*
2026-10-10 AI-Tag
This was created with the help of Assistant, a Unity Artificial Intelligence product.
*/
/*
CommandHud.uss — Crisis Line command header (Brussels Europe Desk reference).
Uses tokens + component classes from Genesis.tss (loaded via PanelSettings).
*/

/* ---- Layout helpers ----------------------------------------- */

.screen-fill {
    flex-grow: 1;
    flex-direction: column;
}

.flex-grow {
    flex-grow: 1;
}

.hidden {
    display: none;
}

.top-container {
    flex-direction: column;
    flex-shrink: 0;
}

/* ---- Command Header ----------------------------------------- */

.command-header {
    flex-direction: column;
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 6px;
    padding-bottom: 6px;
    background-color: rgba(11, 27, 45, 0.96);
    border-bottom-width: 1px;
    border-bottom-color: #244764;
    width: 100%;
    align-self: stretch;
}

.header-main-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 4px;
    padding-bottom: 4px;
    min-height: 48px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.08);
}

.back-btn {
    width: 40px;
    height: 40px;
    border-radius: 20px;
    background-color: rgba(16, 30, 48, 0.95);
    border-width: 1px;
    border-color: #244764;
    margin-right: 8px;
    align-items: center;
    justify-content: center;
    padding: 0;
    flex-shrink: 0;
    transition-duration: 0.12s;
}

.back-btn > Label {
    color: #FFFFFF;
    font-size: 30px;
    -unity-text-align: middle-center;
    margin-top: -3px;
}

.back-btn:hover {
    background-color: rgba(196, 163, 90, 0.14);
}

.header-title-stack {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    margin-right: 8px;
}

.ops-tag {
    /* Meta: year · place — must stay scannable on small phones */
    font-size: 12px;
    color: var(--color-brass);
    letter-spacing: var(--track-meta);
    -unity-font-definition: url("project://database/Assets/UI/Fonts/Inter-SemiBold SDF.asset");
    margin-bottom: 2px;
    opacity: 1;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 100%;
}

.header-title-stack > .top-title,
.top-title.type-screen-title {
    /* Primary theater name — larger than global screen-title token for HUD clarity */
    font-size: 20px;
    color: #F1F3F7;
    -unity-font-definition: url("project://database/Assets/UI/Fonts/Inter-SemiBold SDF.asset");
    letter-spacing: 0.4px;
    /* Allow 2-line wrap so long theater names stay readable instead of ellipsis */
    white-space: normal;
    overflow: hidden;
    text-overflow: clip;
    width: 100%;
    min-width: 0;
    max-height: 48px;
}

/* Status Group — compact horizontal phase + timer (antique-brass accent) */
.ops-status-cluster {
    flex-direction: row;
    align-items: center;
    background-color: rgba(16, 30, 48, 0.98);
    border-width: 1px;
    border-color: #244764;
    border-radius: 10px;
    padding: 5px 9px 7px 9px;
    flex-shrink: 0;
    position: relative;
    overflow: hidden;
    min-height: 36px;
    min-width: 0;
}

.ops-status-phase {
    font-size: var(--type-meta);
    color: var(--color-brass);
    -unity-font-definition: url("project://database/Assets/UI/Fonts/Inter-SemiBold SDF.asset");
    letter-spacing: var(--track-numeric);
    margin-right: 0;
    white-space: nowrap;
}

.ops-status-timer-row {
    flex-direction: row;
    align-items: center;
}

.ops-status-divider {
    width: 1px;
    height: 14px;
    background-color: rgba(255, 255, 255, 0.22);
    margin-left: 7px;
    margin-right: 7px;
    flex-shrink: 0;
    display: flex;
}

.ops-status-clock {
    width: 12px;
    height: 12px;
    margin-right: 4px;
    flex-shrink: 0;
    background-color: transparent;
    border-width: 1.5px;
    border-color: #F2EFE6;
    border-radius: 6px;
    font-size: 1px;
    color: rgba(0, 0, 0, 0);
}

.ops-status-timer {
    font-size: var(--type-numeric);
    color: #FFFFFF;
    -unity-font-definition: url("project://database/Assets/UI/Fonts/Inter-SemiBold SDF.asset");
    letter-spacing: var(--track-numeric);
    white-space: nowrap;
}

/* Bottom progress strip inside phase/timer badge (reference) */
.ops-status-timer-bar {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    overflow: hidden;
    opacity: 1;
    background-color: rgba(196, 163, 90, 0.20);
}

.ops-timer-fill {
    height: 100%;
    background-color: var(--color-brass);
    transition-property: background-color, width;
    transition-duration: 0.35s;
}

.timer-fill--warn { background-color: var(--color-diplomacy); }
.timer-fill--urgent { background-color: var(--color-cost); }

.timer-label--warn { color: var(--color-accent); }
.timer-label--urgent { color: var(--color-cost); }

/* Resource meter strip — flat cells with dividers */
.ops-resource-bar {
    flex-direction: row;
    align-items: stretch;
    justify-content: space-between;
    margin-top: 0;
    padding: 2px 0 0 0;
}

.ops-meter-cell {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    flex-direction: column;
    padding: 2px 6px;
    min-width: 0;
}

.ops-meter-divider {
    width: 1px;
    align-self: stretch;
    min-height: 28px;
    background-color: rgba(255, 255, 255, 0.28);
    margin-top: 2px;
    margin-bottom: 2px;
    flex-shrink: 0;
}

.ops-meter-top {
    flex-direction: row;
    align-items: center;
    margin-bottom: 3px;
    min-height: 18px;
    width: 100%;
}

.ops-meter-icon {
    width: 16px;
    height: 16px;
    margin-right: 4px;
    flex-shrink: 0;
    background-size: contain;
    -unity-background-scale-mode: scale-to-fit;
    background-color: transparent;
}

.ops-meter-icon--stab {
    background-image: url("project://database/Assets/UI/Textures/Icons/icon_stab.png");
}
.ops-meter-icon--cred {
    background-image: url("project://database/Assets/UI/Textures/Icons/icon_cred.png");
}
.ops-meter-icon--toll {
    background-image: url("project://database/Assets/UI/Textures/Icons/icon_toll.png");
}
.ops-meter-icon--esc {
    background-image: url("project://database/Assets/UI/Textures/Icons/icon_esc.png");
}

.ops-meter-label {
    font-size: var(--type-meta);
    color: #D7DEE9;
    letter-spacing: var(--track-meta);
    -unity-font-definition: url("project://database/Assets/UI/Fonts/Inter-SemiBold SDF.asset");
    margin-right: 4px;
    flex-shrink: 0;
}

.ops-meter-value {
    font-size: var(--type-numeric);
    color: #FFFFFF;
    -unity-font-definition: url("project://database/Assets/UI/Fonts/Inter-SemiBold SDF.asset");
    letter-spacing: var(--track-numeric);
    flex-grow: 1;
    margin-left: auto;
    -unity-text-align: middle-right;
    white-space: nowrap;
}

.ops-meter-track {
    height: 5px;
    background-color: rgba(255, 255, 255, 0.16);
    border-radius: 2px;
    overflow: hidden;
    width: 100%;
}

.ops-meter-fill {
    height: 100%;
    border-radius: 2px;
    transition-property: width, background-color;
    transition-duration: 0.45s;
    width: 0%;
}

.ops-meter-fill--flash {
    background-color: #F2EFE6;
}

.ops-meter-fill--stab { background-color: #39C18A; }
.ops-meter-fill--cred { background-color: #4AADE8; }
.ops-meter-fill--toll { background-color: #E35D5B; }
.ops-meter-fill--esc  { background-color: #E5AD3F; }

/* Soft blend into map — solid wash only (UITK linear-gradient renders as artifacts) */
.hud-map-fade {
    height: 14px;
    background-color: rgba(6, 19, 33, 0.32);
    flex-shrink: 0;
}

/* Floating map zoom / recenter — right edge of map band */
.map-controls {
    position: absolute;
    right: 12px;
    top: 118px;
    flex-direction: column;
    align-items: center;
}

.map-controls__btn {
    width: 36px;
    height: 36px;
    margin-bottom: 6px;
    border-radius: 10px;
    background-color: rgba(16, 30, 48, 0.92);
    border-width: 1px;
    border-color: #244764;
    align-items: center;
    justify-content: center;
    padding: 0;
}

.map-controls__btn > Label {
    font-size: 18px;
    color: #F1F3F7;
    -unity-text-align: middle-center;
}

.map-controls__btn:active {
    border-color: #E5AD3F;
    scale: 0.94 0.94;
}

/* ---- Intel chip ---------------------------------------------- */

.intel-chip {
    margin-left: 16px;
    margin-right: 16px;
    margin-top: 8px;
    padding: 0;
    flex-direction: row;
    align-items: stretch;
    background-color: rgba(17, 26, 43, 0.94);
    border-radius: 10px;
    border-width: 1px;
    border-color: rgba(90, 169, 230, 0.32);
    overflow: hidden;
    opacity: 1;
    translate: 0 0;
    transition-property: opacity, translate;
    transition-duration: 0.28s;
    max-height: 48px;
}

.intel-chip--enter {
    opacity: 0;
    translate: 0 -12px;
}

.intel-accent {
    width: 4px;
    background-color: var(--color-info);
    flex-shrink: 0;
}

.intel-icon {
    font-size: 20px;
    color: var(--color-info);
    margin-left: 10px;
    margin-right: 8px;
    flex-shrink: 0;
    -unity-text-align: middle-center;
    align-self: center;
}

.intel-body {
    flex-grow: 1;
    font-size: 16px;
    color: var(--color-text-primary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    padding-top: 10px;
    padding-bottom: 10px;
    padding-right: 12px;
    -unity-text-align: middle-left;
}

/* ---- Field brief card ---------------------------------------- */

.field-brief {
    margin-left: 16px;
    margin-right: 16px;
    margin-top: 8px;
    padding: 12px 16px;
    flex-direction: column;
    background-color: rgba(17, 26, 43, 0.96);
    border-radius: 12px;
    border-width: 1px;
    border-color: rgba(245, 165, 36, 0.35);
    opacity: 1;
    translate: 0 0;
    transition-property: opacity, translate;
    transition-duration: 0.32s;
}

.field-brief--enter {
    opacity: 0;
    translate: 0 -16px;
}

.ui-enter {
    opacity: 0;
    translate: 0 -8px;
    transition-property: opacity, translate;
    transition-duration: 0.28s;
}

.brief-headline {
    font-size: 24px;
    color: var(--color-accent);
    -unity-font-definition: url("project://database/Assets/UI/Fonts/Inter-SemiBold SDF.asset");
    margin-bottom: 4px;
    letter-spacing: 0.5px;
}

.brief-fact {
    font-size: 18px;
    color: var(--color-text-secondary);
    white-space: normal;
}

/* ---- Commit toast -------------------------------------------- */

.commit-toast {
    align-self: center;
    margin-top: 14px;
    font-size: 22px;
    color: var(--color-brass);
    -unity-font-definition: url("project://database/Assets/UI/Fonts/Inter-SemiBold SDF.asset");
    -unity-text-align: middle-center;
    padding: 10px 28px;
    background-color: rgba(196, 163, 90, 0.14);
    border-radius: 28px;
    border-width: 1px;
    border-color: rgba(196, 163, 90, 0.40);
    opacity: 1;
    scale: 1 1;
    transition-property: opacity, scale;
    transition-duration: 0.18s;
}

.commit-toast--enter {
    opacity: 0;
    scale: 0.94 0.94;
}

/* ---- Mission toast (absolute, centered) ---------------------- */

.mission-toast {
    position: absolute;
    left: 40px;
    right: 40px;
    top: 38%;
    font-size: 44px;
    color: var(--color-text-primary);
    -unity-text-align: middle-center;
    -unity-font-definition: url("project://database/Assets/UI/Fonts/Inter-SemiBold SDF.asset");
    background-color: rgba(11, 18, 32, 0.98);
    padding: 40px;
    border-radius: 20px;
    align-self: center;
    border-width: 2px;
    border-color: var(--color-accent);
    text-shadow: 0 4px 8px rgba(0, 0, 0, 0.95);
}

/* Narrow phones — keep header/meters readable without clipping */
@media (max-width: 360px) {
    .command-header {
        padding-left: 12px;
        padding-right: 12px;
        padding-top: 8px;
        padding-bottom: 10px;
        max-width: none;
    }

    .ops-status-cluster {
        min-width: 0;
        padding: 6px 8px 8px 8px;
    }

    .ops-status-phase {
        font-size: var(--type-meta);
    }

    .ops-status-timer {
        font-size: var(--type-numeric);
    }

    .ops-meter-cell {
        padding: 2px 3px;
    }

    .ops-meter-label {
        font-size: var(--type-meta);
        letter-spacing: var(--track-meta);
    }

    .ops-meter-value {
        font-size: var(--type-numeric);
    }

    .ops-tag {
        font-size: 12px;
    }

    .header-title-stack > .top-title,
    .top-title.type-screen-title {
        font-size: 18px;
        max-height: 44px;
    }
}

/* Tablet reading-width cap is applied from C# via LogicalScreenWidth(), not raw pixels. */
