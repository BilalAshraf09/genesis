/*
OrderSheet — state-of-art mobile war desk rail.
Sheet horizontal padding + bottom safe spacer prevent hold-button corner clipping.
Cards use flex zones; selected state keeps 2px border (color only) to avoid layout jump.
*/

.screen-fill {
    flex-grow: 1;
    flex-direction: column;
}

.flex-grow {
    flex-grow: 1;
}

.hidden {
    display: none;
}

.order-sheet {
    flex-direction: column;
    background-color: rgba(11, 18, 32, 0.97);
    border-top-left-radius: 24px;
    border-top-right-radius: 24px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.12);
    border-bottom-width: 0;
    transition-duration: 0.22s;
    overflow: hidden;
    max-height: 88%;
    min-height: 0;
    padding-left: 20px;
    padding-right: 20px;
}

.drag-handle {
    height: 28px;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}

.drag-pill {
    width: 56px;
    height: 5px;
    background-color: rgba(255, 255, 255, 0.28);
    border-radius: 3px;
}

.sheet-header {
    flex-direction: row;
    align-items: center;
    padding-bottom: 0;
    flex-shrink: 0;
    height: 44px;
    min-height: 44px;
    max-height: 44px;
    overflow: hidden;
}

.place-name-label {
    font-size: 28px;
    color: #F5A524;
    -unity-font-definition: url("project://database/Assets/UI/Fonts/Inter-SemiBold SDF.asset");
    flex-grow: 1;
    flex-shrink: 1;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.beat-title-label {
    font-size: 22px;
    color: #A9B3C4;
    flex-shrink: 0;
    margin-left: 10px;
    max-width: 200px;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    -unity-text-align: middle-right;
}

/* Fixed horizontal rail — no ScrollView (avoids vertical/horizontal nested pans). */
.card-rail {
    flex-direction: row;
    align-items: stretch;
    justify-content: flex-start;
    flex-grow: 0;
    flex-shrink: 0;
    margin-bottom: 12px;
    overflow: hidden;
    width: 100%;
}

/* ---- Order card ---- */

.order-card {
    flex-shrink: 0;
    align-self: stretch;
    margin-right: 0;
    flex-direction: column;
    padding: 12px 12px 10px 12px;
    background-color: rgba(23, 35, 58, 0.96);
    border-radius: 14px;
    /* Constant 2px border — selected only changes color (no header clip jump). */
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.08);
    overflow: hidden;
}

.order-card--selected {
    background-color: rgba(245, 165, 36, 0.14);
    border-color: #F5A524;
}

.order-card--compact {
    padding: 10px 8px 8px 8px;
    border-radius: 12px;
}

.order-card__header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    flex-shrink: 0;
    min-height: 24px;
    margin-bottom: 6px;
    overflow: hidden;
}

.order-card__kind {
    font-size: 15px;
    color: #F5A524;
    -unity-font-definition: url("project://database/Assets/UI/Fonts/Inter-SemiBold SDF.asset");
    flex-shrink: 1;
    flex-grow: 1;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    padding-top: 2px;
    min-width: 0;
}

.order-card--compact .order-card__kind {
    font-size: 13px;
}

.order-card__place {
    font-size: 13px;
    color: #A9B3C4;
    background-color: rgba(0, 0, 0, 0.28);
    padding: 2px 6px;
    border-radius: 6px;
    max-width: 42%;
    margin-left: 4px;
    flex-shrink: 1;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.order-card__title {
    font-size: 22px;
    color: #F2EFE6;
    -unity-font-definition: url("project://database/Assets/UI/Fonts/Inter-SemiBold SDF.asset");
    white-space: normal;
    flex-shrink: 0;
    min-height: 0;
    max-height: 120px;
    overflow: hidden;
    margin-bottom: 6px;
    -unity-text-align: upper-left;
}

.order-card--compact .order-card__title {
    font-size: 18px;
    max-height: 110px;
}

.order-card__desc {
    font-size: 16px;
    color: #A9B3C4;
    white-space: normal;
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    max-height: 72px;
    overflow: hidden;
    margin-bottom: 6px;
    -unity-text-align: upper-left;
}

.order-card--compact .order-card__desc {
    font-size: 14px;
    max-height: 64px;
}

.order-card__chips {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    flex-shrink: 0;
    min-height: 28px;
    max-height: 56px;
    overflow: hidden;
    margin-top: auto;
}

.order-card__chips > .chip {
    font-size: 12px;
    padding: 3px 6px;
    margin-right: 4px;
    margin-bottom: 4px;
    border-radius: 6px;
    flex-shrink: 1;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 100%;
}

/* ---- Hold footer ---- */

.hold-button-container {
    flex-grow: 0;
    flex-shrink: 0;
    flex-direction: column;
    align-self: stretch;
    margin-bottom: 0;
    overflow: visible;
}

.hold-button-container > .hold-btn {
    width: 100%;
}

.gesture-spacer {
    flex-grow: 0;
    flex-shrink: 0;
    height: 12px;
}

.hold-btn {
    flex-grow: 1;
    flex-shrink: 0;
    align-self: stretch;
    margin: 0;
    padding: 0;
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    min-height: 88px;
    border-radius: 18px;
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.14);
    background-color: rgba(245, 165, 36, 0.12);
    overflow: hidden;
    position: relative;
}

.hold-btn__fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 0%;
    background-color: rgba(245, 165, 36, 0.28);
    border-radius: 16px;
}

.hold-btn--armed {
    background-color: rgba(245, 165, 36, 0.20);
    border-color: #F5A524;
}

.hold-btn--holding {
    background-color: rgba(245, 165, 36, 0.28);
    border-color: #F5A524;
}

.hold-btn--success {
    background-color: rgba(63, 185, 122, 0.28);
    border-color: #3FB97A;
}

.hold-btn--success .hold-btn__fill {
    width: 100%;
    background-color: rgba(63, 185, 122, 0.4);
}

.hold-btn--success .hold-btn__label {
    color: #3FB97A;
}

.hold-btn--idle {
    background-color: rgba(255, 255, 255, 0.04);
    border-color: rgba(255, 255, 255, 0.10);
}

.hold-btn--locked {
    opacity: 0.55;
}

.hold-btn__ring-canvas {
    width: 44px;
    height: 44px;
    flex-shrink: 0;
    margin-left: 16px;
    margin-right: 12px;
}

.hold-btn__label {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    font-size: 28px;
    color: #F5A524;
    -unity-font-definition: url("project://database/Assets/UI/Fonts/Inter-SemiBold SDF.asset");
    -unity-text-align: middle-left;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    margin-right: 16px;
}

.hold-btn__sublabel {
    font-size: 20px;
    color: #A9B3C4;
    -unity-text-align: middle-left;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    margin-right: 16px;
    margin-top: 2px;
}

.hold-btn--idle .hold-btn__label,
.hold-btn--locked .hold-btn__label {
    color: #6E7A8F;
}

.hold-btn__text-col {
    flex-grow: 1;
    flex-shrink: 1;
    flex-direction: column;
    justify-content: center;
    min-width: 0;
    margin-right: 8px;
}
