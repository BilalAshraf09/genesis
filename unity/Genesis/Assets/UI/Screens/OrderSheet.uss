/*
2026-10-10 AI-Tag
This was created with the help of Assistant, a Unity Artificial Intelligence product.
*/
/*
OrderSheet — Europe Desk decision drawer (Brussels Crisis Line reference).
Unity USS: no sibling combinators (+/~).
*/

.screen-fill {
    flex-grow: 1;
    flex-direction: column;
}

.flex-grow {
    flex-grow: 1;
}

.hidden {
    display: none;
}

/* ---- Sheet shell ---------------------------------------- */

.order-sheet {
    flex-direction: column;
    background-color: rgba(11, 27, 45, 0.988);
    border-top-left-radius: 18px;
    border-top-right-radius: 18px;
    border-width: 1px;
    border-color: #244764;
    border-bottom-width: 0;
    transition-duration: 0.18s;
    overflow: hidden;
    max-height: 90%;
    min-height: 0;
    padding-left: 12px;
    padding-right: 12px;
    position: relative;
    width: 100%;
    align-self: stretch;
}

.sheet-urgency-line {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 2px;
    background-color: var(--color-brass);
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.3s;
}

.sheet--warn .sheet-urgency-line {
    opacity: 1;
    background-color: var(--color-brass);
}

.sheet--urgent .sheet-urgency-line {
    opacity: 1;
    background-color: #E5534B;
}

.drag-handle {
    height: 14px;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    margin-top: 4px;
}

.drag-pill {
    width: 36px;
    height: 3px;
    background-color: rgba(196, 163, 90, 0.45);
    border-radius: 2px;
}

/* ---- Header --------------------------------------------- */

.sheet-header {
    flex-direction: column;
    align-items: stretch;
    justify-content: flex-start;
    flex-shrink: 0;
    min-height: 64px;
    max-height: 92px;
    width: 100%;
    padding-bottom: 2px;
    overflow: hidden;
}

.sheet-eyebrow {
    font-size: var(--type-category);
    color: var(--color-brass);
    -unity-font-definition: url("project://database/Assets/UI/Fonts/Inter-SemiBold SDF.asset");
    letter-spacing: var(--track-meta);
    margin-bottom: 1px;
    flex-shrink: 0;
}

.place-name-label {
    font-size: var(--type-panel-title);
    color: #F1F3F7;
    -unity-font-definition: url("project://database/Assets/UI/Fonts/Inter-SemiBold SDF.asset");
    letter-spacing: var(--track-title);
    flex-shrink: 0;
    width: 100%;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    margin-bottom: 2px;
}

.beat-title-label {
    font-size: var(--type-body);
    color: #A8BCD0;
    -unity-font-definition: url("project://database/Assets/UI/Fonts/Inter-Regular SDF.asset");
    letter-spacing: 0;
    flex-shrink: 1;
    width: 100%;
    overflow: hidden;
    white-space: normal;
    /* 2 lines — wraps instead of one-line ellipsis */
    max-height: 40px;
    -unity-text-align: upper-left;
    opacity: 1;
}

/* ---- Card rail (horizontal) ----------------------------- */

.card-rail {
    flex-direction: row;
    align-items: stretch;
    justify-content: flex-start;
    flex-grow: 0;
    flex-shrink: 0;
    margin-top: 6px;
    margin-bottom: 8px;
    overflow: hidden;
    width: 100%;
}

.card-rail--scroll {
    overflow: hidden;
    position: relative;
}

.card-rail__scroll-hint {
    position: absolute;
    right: 0;
    top: 0;
    bottom: 0;
    width: 28px;
    background-color: rgba(11, 18, 32, 0.55);
    display: none;
}

.card-rail--stack {
    flex-direction: column;
    overflow: hidden;
}

.card-rail__content {
    flex-direction: row;
    align-items: stretch;
    justify-content: flex-start;
    flex-shrink: 1;
    flex-grow: 1;
    width: 100%;
    height: 100%;
    min-width: 0;
}

/* ---- Order card ----------------------------------------- */

.order-card {
    flex-shrink: 1;
    flex-grow: 1;
    flex-basis: 0%;
    align-self: stretch;
    min-width: 0;
    margin-right: 0;
    flex-direction: column;
    padding: 0;
    background-color: rgba(16, 30, 48, 0.96);
    border-radius: 12px;
    border-width: 1.5px;
    border-color: #244764;
    overflow: hidden;
    transition-property: border-color, background-color, scale;
    transition-duration: 0.12s;
    position: relative;
}

.order-card__glow {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: transparent;
    border-radius: 12px;
    border-width: 0;
    transition-duration: 0.15s;
}

.order-card__body {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    flex-direction: column;
    /* Header → title → desc → deltas (pinned via margin-top:auto) */
    padding: 10px 9px 9px 9px;
    position: relative;
}

.order-card--selected {
    background-color: rgba(18, 32, 50, 0.99);
    /* Keep border-width identical to unselected so flex columns stay equal width */
    border-width: 1.5px;
    border-color: #E5AD3F;
}

.order-card--selected .order-card__glow {
    border-width: 0;
    background-color: rgba(229, 173, 63, 0.12);
}

/* V2 mockup: unselected peers fade when a choice is locked in */
.order-card--dimmed {
    opacity: 0.42;
}

.order-card--pressed {
    scale: 0.985 0.985;
    background-color: rgba(23, 35, 58, 0.99);
    border-color: rgba(196, 163, 90, 0.55);
}

.order-card--disabled {
    opacity: 0.45;
}

.order-card__check {
    position: absolute;
    top: 8px;
    right: 8px;
    width: 16px;
    height: 16px;
    border-radius: 8px;
    background-color: var(--color-brass);
    opacity: 0;
    transition-property: opacity, scale;
    transition-duration: 0.12s;
    scale: 0.8 0.8;
}

.order-card--selected .order-card__check {
    opacity: 1;
    scale: 1 1;
}

.order-card__check-mark {
    font-size: 11px;
    color: #0B1220;
    -unity-font-definition: url("project://database/Assets/UI/Fonts/Inter-SemiBold SDF.asset");
    -unity-text-align: middle-center;
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
}

.order-card--compact .order-card__body {
    padding: 8px 8px 8px 8px;
}

.order-card__header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    flex-shrink: 0;
    margin-bottom: 5px;
    min-height: 22px;
    padding-right: 18px;
}

.order-card__icon {
    width: 22px;
    height: 22px;
    margin-bottom: 0;
    margin-right: 5px;
    flex-shrink: 0;
    background-size: contain;
    -unity-background-scale-mode: scale-to-fit;
    background-color: transparent;
}

.order-card__icon--political {
    background-image: url("project://database/Assets/UI/Textures/Icons/icon_political.png");
}
.order-card__icon--diplomatic {
    background-image: url("project://database/Assets/UI/Textures/Icons/icon_diplomatic.png");
}
.order-card__icon--people {
    background-image: url("project://database/Assets/UI/Textures/Icons/icon_people.png");
}
.order-card__icon--military {
    background-image: url("project://database/Assets/UI/Textures/Icons/icon_esc.png");
}

.order-card__kind {
    font-size: 8px;
    color: #F1F3F7;
    -unity-font-definition: url("project://database/Assets/UI/Fonts/Inter-SemiBold SDF.asset");
    letter-spacing: 0.5px;
    background-color: rgba(6, 19, 33, 0.95);
    border-radius: 5px;
    border-width: 1px;
    border-color: rgba(90, 143, 184, 0.4);
    padding: 2px 5px;
    flex-shrink: 1;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    margin-bottom: 0;
    margin-left: auto;
    max-width: 72%;
}

.order-card--military .order-card__kind {
    color: #F4C76B;
    border-color: rgba(217, 164, 65, 0.70);
    background-color: rgba(217, 164, 65, 0.14);
}
.order-card--diplomatic .order-card__kind {
    color: #A8D0EC;
    border-color: rgba(90, 143, 184, 0.70);
    background-color: rgba(90, 143, 184, 0.16);
}
.order-card--political .order-card__kind {
    color: #C9B4DE;
    border-color: rgba(139, 111, 168, 0.70);
    background-color: rgba(139, 111, 168, 0.16);
}
.order-card--covert .order-card__kind {
    color: #C9B8E8;
    border-color: rgba(160, 132, 220, 0.55);
    background-color: rgba(160, 132, 220, 0.14);
}
.order-card--economic .order-card__kind {
    color: #9EE0BC;
    border-color: rgba(63, 185, 122, 0.65);
    background-color: rgba(63, 185, 122, 0.14);
}

.order-card__title {
    font-size: var(--type-card-title);
    color: #F2EFE6;
    -unity-font-definition: url("project://database/Assets/UI/Fonts/Inter-SemiBold SDF.asset");
    letter-spacing: var(--track-title);
    white-space: normal;
    flex-grow: 0;
    flex-shrink: 0;
    overflow: hidden;
    margin-bottom: 4px;
    -unity-text-align: upper-left;
    max-height: 60px;
}

.order-card--compact .order-card__title {
    font-size: var(--type-card-title);
    -unity-text-align: upper-left;
    max-height: 40px;
}

.order-card__desc {
    font-size: var(--type-secondary);
    color: #A9B3C4;
    -unity-font-definition: url("project://database/Assets/UI/Fonts/Inter-Regular SDF.asset");
    letter-spacing: 0;
    white-space: normal;
    flex-grow: 0;
    flex-shrink: 1;
    overflow: hidden;
    margin-bottom: 4px;
    opacity: 1;
    max-height: 34px;
    min-height: 0;
}

.order-card--compact .order-card__desc {
    /* Keep a one-line hint even in compact — never blank the decision */
    display: flex;
    max-height: 17px;
    color: #A9B3C4;
    opacity: 1;
}

.order-card__deltas {
    flex-direction: row;
    align-items: flex-end;
    justify-content: flex-start;
    flex-shrink: 0;
    margin-top: auto;
    padding-top: 2px;
    min-height: 24px;
    flex-wrap: wrap;
}

.delta-pill {
    flex-direction: row;
    align-items: center;
    padding: 3px 6px;
    margin-right: 3px;
    margin-bottom: 1px;
    border-radius: 6px;
    background-color: rgba(63, 185, 122, 0.22);
    border-width: 0;
    border-color: rgba(0, 0, 0, 0);
}

.delta-pill__label {
    font-size: var(--type-effect);
    color: #5FD49A;
    -unity-font-definition: url("project://database/Assets/UI/Fonts/Inter-SemiBold SDF.asset");
    letter-spacing: var(--track-numeric);
    white-space: nowrap;
}

.delta-pill--gain {
    border-width: 0;
    background-color: rgba(63, 185, 122, 0.22);
}
.delta-pill--gain .delta-pill__label {
    color: #5FD49A;
}

.delta-pill--cost {
    border-width: 0;
    background-color: rgba(229, 83, 75, 0.22);
}
.delta-pill--cost .delta-pill__label {
    color: #E5534B;
}

.delta-pill--warn {
    border-width: 0;
    background-color: rgba(245, 165, 36, 0.22);
}
.delta-pill--warn .delta-pill__label {
    color: #F5A524;
}

.delta-pill--info {
    border-width: 0;
    background-color: rgba(90, 169, 230, 0.22);
}
.delta-pill--info .delta-pill__label {
    color: #5AA9E6;
}

/* ---- Hold / commit -------------------------------------- */

.hold-button-container {
    flex-grow: 0;
    flex-shrink: 0;
    flex-direction: column;
    align-self: stretch;
    /* Peek height is content-driven — keep CTA immediately under the card rail.
       Half/Full snaps may leave slack above; avoid margin-top:auto (UITK often
       resolves it to 0 and parks empty navy under the button instead).
       No padding-top: it was double-counting HoldHeight and pushing the button
       + gesture spacer past the sheet bottom (stray paint under HOLD). */
    margin-top: 0;
    margin-bottom: 0;
    overflow: hidden;
    padding-top: 0;
}

.hold-button-container > .hold-btn {
    width: 100%;
}

.gesture-spacer {
    flex-grow: 0;
    flex-shrink: 0;
    height: 10px;
}

/* Override Unity default .unity-button chrome so armed brass wins */
.hold-btn {
    flex-grow: 1;
    flex-shrink: 0;
    align-self: stretch;
    margin: 0;
    padding: 0;
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    min-height: 68px;
    border-radius: 14px;
    border-width: 1px;
    border-color: #244764;
    background-color: rgba(16, 30, 48, 0.95);
    background-image: none;
    /* Clip to button — overflow:visible painted subtitle under the sheet edge */
    overflow: hidden;
    position: relative;
    transition-duration: 0.12s;
}

.hold-btn__fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 0%;
    background-color: rgba(11, 18, 32, 0.18);
    border-radius: 0;
}

.hold-btn--armed {
    background-color: #E5AD3F;
    border-width: 0;
    border-color: rgba(0, 0, 0, 0);
    background-image: none;
}

.hold-btn--armed .hold-btn__label {
    color: #061321;
}

.hold-btn--armed .hold-btn__sublabel {
    color: rgba(11, 18, 32, 0.72);
}

.hold-btn--armed .hold-btn__arrow {
    color: #0B1220;
}

.hold-btn--holding {
    background-color: #B8944A;
    border-width: 0;
    background-image: none;
    translate: 0 1px;
}

.hold-btn--holding .hold-btn__label {
    color: #0B1220;
}

.hold-btn--holding .hold-btn__sublabel {
    color: rgba(11, 18, 32, 0.75);
}

.hold-btn--holding .hold-btn__arrow {
    color: #0B1220;
}

.hold-btn--success {
    background-color: #3FB97A;
    border-width: 0;
    background-image: none;
}

.hold-btn--success .hold-btn__fill {
    width: 100%;
    background-color: rgba(11, 18, 32, 0.12);
}

.hold-btn--success .hold-btn__label {
    color: #0B1220;
}

.hold-btn--success .hold-btn__sublabel {
    color: rgba(11, 18, 32, 0.75);
}

.hold-btn--success .hold-btn__arrow {
    color: #0B1220;
}

.hold-btn--idle {
    background-color: rgba(196, 163, 90, 0.08);
    border-width: 1.5px;
    border-color: rgba(196, 163, 90, 0.40);
    background-image: none;
}

.hold-btn--locked {
    opacity: 0.48;
}

.hold-btn__ring-canvas {
    width: 32px;
    height: 32px;
    flex-shrink: 0;
    margin-left: 12px;
    margin-right: 10px;
}

.hold-btn__label {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    font-size: var(--type-hold);
    color: var(--color-brass);
    -unity-font-definition: url("project://database/Assets/UI/Fonts/Inter-SemiBold SDF.asset");
    -unity-text-align: middle-left;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    margin-right: 8px;
    letter-spacing: var(--track-meta);
}

.hold-btn__sublabel {
    font-size: var(--type-hold-sub);
    color: #DCE3EE;
    -unity-font-definition: url("project://database/Assets/UI/Fonts/Inter-SemiBold SDF.asset");
    -unity-text-align: middle-left;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    margin-right: 8px;
    margin-top: 2px;
    min-height: 16px;
    flex-shrink: 0;
    opacity: 1;
}

.hold-btn--idle .hold-btn__label {
    color: var(--color-brass);
}

.hold-btn--locked .hold-btn__label {
    color: #6E7A8F;
}

.hold-btn--idle .hold-btn__sublabel {
    color: #A9B3C4;
}

.hold-btn--locked .hold-btn__sublabel {
    color: #6E7A8F;
}

.hold-btn--idle .hold-btn__arrow {
    color: var(--color-brass);
}

.hold-btn--locked .hold-btn__arrow {
    color: #6E7A8F;
}

.hold-btn__text-col {
    flex-grow: 1;
    flex-shrink: 1;
    flex-direction: column;
    justify-content: center;
    min-width: 0;
    margin-right: 8px;
}

.hold-btn__arrow {
    font-size: 18px;
    color: #0B1220;
    flex-shrink: 0;
    margin-right: 14px;
    -unity-text-align: middle-center;
    -unity-font-definition: url("project://database/Assets/UI/Fonts/Inter-SemiBold SDF.asset");
}

.hold-btn__sublabel.hidden {
    display: none;
}

/* Narrow phones — scrollable card rail, tighter sheet chrome */
@media (max-width: 360px) {
    .order-sheet {
        padding-left: 10px;
        padding-right: 10px;
        max-width: none;
        border-top-left-radius: 16px;
        border-top-right-radius: 16px;
    }

    .sheet-header {
        min-height: 58px;
        max-height: 86px;
    }

    .beat-title-label {
        max-height: 34px;
    }

    .place-name-label {
        font-size: var(--type-panel-title);
    }

    .order-card__title {
        font-size: var(--type-card-title);
    }

    .order-card__desc {
        font-size: var(--type-secondary);
    }

    .hold-btn {
        min-height: 64px;
        border-radius: 12px;
    }

    .hold-btn__label {
        font-size: var(--type-hold);
    }

    .hold-btn__sublabel {
        font-size: var(--type-hold-sub);
    }
}

/* Do NOT use panel-unit min-width:600 here — ScaleWithScreenSize reports
   ~800+ panel units on phones. Tablet cap uses C# LogicalScreenWidth() (not raw pixels). */
