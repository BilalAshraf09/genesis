/* ============================================================
   Genesis — Settings  (Night Atlas)
   ============================================================ */

/* ── Screen root ─────────────────────────────────────────── */
.settings-screen {
    flex-grow: 1;
    flex-direction: column;
    background-color: #0B1220;
}

/* ── Header bar ──────────────────────────────────────────── */
.settings-header {
    flex-direction: row;
    align-items: center;
    background-color: #111A2BDB;
    border-bottom-width: 1px;
    border-color: #FFFFFF14;
    padding-left: 16px;
    padding-right: 24px;
    padding-top: 16px;
    padding-bottom: 16px;
    flex-shrink: 0;
}

.settings-header__back-btn {
    background-color: rgba(0,0,0,0);
    border-width: 0;
    border-radius: 12px;
    width: 72px;
    height: 72px;
    align-items: center;
    justify-content: center;
    margin-right: 8px;
    transition-duration: 0.12s;
}

.settings-header__back-btn > Label {
    font-size: 32px;
    color: #F2EFE6;
}

.settings-header__back-btn:active {
    scale: 0.92 0.92;
    background-color: #FFFFFF14;
}

.settings-header__title {
    font-size: 40px;
    color: #F2EFE6;
    -unity-font-definition: url("project://database/Assets/UI/Fonts/Inter-SemiBold SDF.asset");
    letter-spacing: 6px;
    flex-grow: 1;
}

/* ── Scroll content ──────────────────────────────────────── */
.settings-scroll {
    flex-grow: 1;
    padding-left: 16px;
    padding-right: 16px;
    padding-top: 20px;
    padding-bottom: 40px;
}

.settings-scroll > #unity-content-container {
    flex-direction: column;
}

/* ── Section card ─────────────────────────────────────────── */
.settings-section {
    background-color: #17233A;
    border-width: 1px;
    border-color: #FFFFFF14;
    border-radius: 20px;
    padding: 24px;
    margin-bottom: 16px;
    flex-direction: column;
}

.settings-section__heading {
    font-size: 24px;
    color: #6E7A8F;
    letter-spacing: 4px;
    margin-bottom: 16px;
}

.settings-section__label {
    font-size: 30px;
    color: #F2EFE6;
    white-space: normal;
}

/* ── Quality buttons ─────────────────────────────────────── */
.quality-btn {
    background-color: #111A2B;
    border-width: 1px;
    border-color: #FFFFFF14;
    border-radius: 14px;
    height: 84px;
    align-items: center;
    justify-content: center;
    padding-left: 20px;
    padding-right: 20px;
    margin-bottom: 10px;
    flex-direction: row;
    transition-duration: 0.12s;
}

.quality-btn > Label {
    font-size: 28px;
    color: #A9B3C4;
    flex-grow: 1;
}

.quality-btn:active { scale: 0.97 0.97; }

.quality-btn--active {
    border-color: #F5A524;
    background-color: #F5A52414;
}

.quality-btn--active > Label {
    color: #F5A524;
}

.quality-btn__badge {
    font-size: 22px;
    color: #6E7A8F;
}

.quality-btn--active > .quality-btn__badge {
    color: #F5A52480;
}

/* ── Toggle row ──────────────────────────────────────────── */
.toggle-row {
    flex-direction: row;
    align-items: center;
    height: 72px;
}

.toggle-row__label {
    font-size: 30px;
    color: #F2EFE6;
    flex-grow: 1;
}

.toggle-pill {
    background-color: #111A2B;
    border-width: 1px;
    border-color: #FFFFFF14;
    border-radius: 24px;
    width: 120px;
    height: 52px;
    align-items: center;
    justify-content: center;
    transition-duration: 0.2s;
}

.toggle-pill > Label {
    font-size: 24px;
    color: #6E7A8F;
    -unity-font-definition: url("project://database/Assets/UI/Fonts/Inter-SemiBold SDF.asset");
}

.toggle-pill--on {
    background-color: #3FB97A26;
    border-color: #3FB97A;
}

.toggle-pill--on > Label {
    color: #3FB97A;
}

.toggle-pill:active { scale: 0.94 0.94; }

/* ── Premium / account row ───────────────────────────────── */
.settings-action-btn {
    background-color: #111A2B;
    border-width: 1px;
    border-color: #FFFFFF14;
    border-radius: 14px;
    height: 84px;
    align-items: center;
    justify-content: center;
    padding-left: 20px;
    padding-right: 20px;
    margin-top: 12px;
    transition-duration: 0.12s;
}

.settings-action-btn > Label {
    font-size: 28px;
    color: #F2EFE6;
}

.settings-action-btn:active { scale: 0.97 0.97; }

.settings-status-label {
    font-size: 26px;
    color: #A9B3C4;
    margin-bottom: 4px;
    white-space: normal;
}

.settings-status-label--pro {
    color: #3FB97A;
}
