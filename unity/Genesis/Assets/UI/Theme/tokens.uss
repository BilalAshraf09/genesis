/*
2026-10-01 AI-Tag
This was created with the help of Assistant, a Unity Artificial Intelligence product.
*/
/* ============================================================
   Genesis — Night Atlas design tokens
   Reference resolution: 1080 × 1920 (ScaleWithScreenSize 0.5)
   ============================================================ */

:root {
    /* ---- Colours (1914 / Living Atlas mockup palette) ----- */
    --color-ocean:        #061421;
    --color-surface:      #0D2032;
    --color-surface-2:    #10283D;
    /* Glass: rgba(13,32,50,0.90) */
    --color-glass:        #0D2032E6;
    /* Technical blue outline */
    --color-border:       #294B64;

    --color-text-primary:   #F2F5F8;
    --color-text-secondary: #A8B9C9;
    --color-text-muted:     #7A90A8;

    --color-accent:       #FFC95A;
    /* Antique gold — primary actions / selected rims */
    --color-brass:        #E5AD3F;
    --color-brass-dim:    #A67C2E;
    --color-navy-deep:    #061421;
    --color-navy-panel:   #0D2032;
    --color-gain:         #39C18A;
    --color-cost:         #E35D5B;
    --color-escalation:   #E5AD3F;
    --color-diplomacy:    #4AADE8;
    --color-politics:     #8B6FA8;
    --color-info:         #4AADE8;
    --color-stab:         #39C18A;
    --color-cred:         #4AADE8;
    --color-toll:         #E35D5B;
    --color-esc:          #E5AD3F;

    /* ---- Radii -------------------------------------------- */
    --radius-sm: 10px;
    --radius-md: 16px;
    --radius-lg: 24px;

    /* ---- Spacing scale (4-base) --------------------------- */
    --space-1: 4px;
    --space-2: 8px;
    --space-3: 12px;
    --space-4: 16px;
    --space-6: 24px;
    --space-8: 32px;

    /* ---- Type scale (legacy menus / dense screens) ------- */
    --font-caption: 20px;
    --font-body:    24px;
    --font-title:   30px;
    --font-h2:      38px;
    --font-h1:      52px;

    /* ---- Theater UI type scale @ 882×1784 panel units ------
       Premium strategy readability (Inter). Sizes are panel units,
       not CSS device px — keep hierarchy, not a global multiplier.
       Weights: Regular + SemiBold SDF only (Medium/Bold roles → SemiBold).
       Modest bump for mobile; avoid layout-breaking jumps. */
    --type-screen-title: 19px;   /* .type-screen-title — SemiBold */
    --type-panel-title:  23px;   /* .type-section-title — SemiBold (Bold role) */
    --type-card-title:   16px;   /* .type-card-title — SemiBold */
    --type-body:         15px;   /* .type-body — Regular */
    --type-secondary:    14px;   /* .type-secondary — Regular */
    --type-category:     11px;   /* .type-category — SemiBold */
    --type-effect:       12px;   /* .type-effect-badge — SemiBold */
    --type-hold:         16px;
    --type-hold-sub:     13px;
    --type-meta:         13px;   /* .type-status-label — SemiBold (Medium role) */
    --type-numeric:      15px;   /* .type-status-value / timer — SemiBold */
    --type-callout-title: 15px;
    --type-callout-body:  14px;
    --type-map-label:     16px;

    /* Tracking — restrained; uppercase meta only.
       Numeric tracking approximates tabular feel (UITK has no tnum USS). */
    --track-meta:    1.2px;
    --track-title:   0.2px;
    --track-numeric: 0.15px;

    /* ---- Content constraints ------------------------------ */
    /* Panel-unit reading width (≈ large-phone width @ ref 882).
       Do NOT use device logical points (390/430) here — ScaleWithScreenSize
       panel units are ~2× larger; 430px was the narrow centered-column bug. */
    --content-max-width: 860px;
    --gutter: 16px;

    /* ---- Primary UI font (Inter — already bundled as SDF) -- */
    -unity-font-definition: url("project://database/Assets/UI/Fonts/Inter-Regular SDF.asset");
}
